# Names only. Set real values in Vercel (Project → Settings → Environment Variables), or in .env.local for
# `npm run eval` (gitignored). Each secret must match the TrueRing function secret of the same name.
TR_BRIDGE_URL=https://<project>.supabase.co/functions/v1/sample-redaction-bridge
SAMPLE_REDACTOR_BRIDGE_SECRET=
SAMPLE_REDACTOR_START_SECRET=
ASSEMBLYAI_API_KEY=
OPENROUTER_API_KEY=
# optional, pinned in lib/config.ts; changing one means bumping PIPELINE_VERSION
# ASSEMBLYAI_SPEECH_MODEL=
# OPENROUTER_MODEL=
