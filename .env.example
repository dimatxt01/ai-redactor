# Names only. Set the real values in the worker host's secret store (e.g. /etc/ai-redactor.env, chmod 600), never in git.
# SAMPLE_REDACTOR_BRIDGE_SECRET must equal the TrueRing Supabase function secret of the same name.
TR_BRIDGE_URL=https://<project>.supabase.co/functions/v1/sample-redaction-bridge
SAMPLE_REDACTOR_BRIDGE_SECRET=
# A key used by this worker ONLY: the orphan sweep deletes any transcript on that account older than ORPHAN_AGE_S.
ASSEMBLYAI_API_KEY=
OPENROUTER_API_KEY=
# optional
# WORKER_CONCURRENCY=2      jobs at once in this process (1-6)
# POLL_S=20                 seconds between bridge polls (min 2; keep far below TR's SAMPLE_WORKER_STALE_S, 300)
# ASR_POLL_S=10             seconds between AssemblyAI status checks
# ORPHAN_AGE_S=8100         transcripts older than this (2 h 15 m, past the 2 h job deadline) belong to no live job
# ORPHAN_SWEEP_S=1800       how often the orphan sweep runs
# ALIVE_FILE=/tmp/ai-redactor-alive   written after each successful poll (Docker HEALTHCHECK reads its age)
# ASSEMBLYAI_SPEECH_MODEL=  pinned in lib/config.ts; changing one means bumping PIPELINE_VERSION
# OPENROUTER_MODEL=
