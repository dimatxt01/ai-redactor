{
  "name": "ai-redactor",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev -p 3100",
    "prebuild": "node scripts/check-ffmpeg.mjs",
    "build": "next build",
    "start": "next start -p 3100",
    "pretest": "node scripts/check-ffmpeg.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --incremental false",
    "make-test-calls": "tsx scripts/make-test-calls.ts",
    "eval": "tsx scripts/eval-test-calls.ts",
    "validate": "bash scripts/validate.sh",
    "simulate": "tsx sim/run.ts"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "workflow": "5.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module"
}
