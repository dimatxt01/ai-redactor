{
  "name": "ai-redactor",
  "version": "1.0.0",
  "scripts": {
    "start": "node --import tsx src/worker.ts",
    "check": "node --import tsx src/check.ts",
    "pretest": "node scripts/check-ffmpeg.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --incremental false",
    "make-test-calls": "tsx scripts/make-test-calls.ts",
    "eval": "tsx scripts/eval-test-calls.ts",
    "simulate": "tsx sim/run.ts",
    "validate": "bash scripts/validate.sh",
    "postinstall": "node scripts/check-ffmpeg.mjs"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "zod": "4.6.7",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  },
  "description": "TrueRing Recording Library worker: a plain Node background process that pulls jobs from TrueRing's sample-redaction-bridge"
}
